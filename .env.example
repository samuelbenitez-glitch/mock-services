PORT=3101
HOST=0.0.0.0

# Gateway local (/v1/*): APIs Java locales + fallback al gateway de staging
LOCAL_GATEWAY_ENABLED=false
LOCAL_GATEWAY_ROUTES=catalogos=http://localhost:8080,stock=http://localhost:8100
LOCAL_GATEWAY_FALLBACK=https://api-gateway-firewall-alloydb.backend-staging.staging.maxirest.com
# Token que aceptan las APIs locales (clave de desarrollo); se relee en cada peticion
LOCAL_GATEWAY_TOKEN_FILE=
LOCAL_GATEWAY_CORS_ORIGINS=http://localhost:4200,http://localhost:4210
